{
  "name": "expo-env-doctor",
  "version": "0.0.0",
  "description": "Find Expo environment variables that will be undefined on device: checks your code against .env files, eas.json and EAS environments.",
  "keywords": [
    "expo",
    "eas",
    "eas-build",
    "eas-update",
    "env",
    "dotenv",
    "environment-variables",
    "EXPO_PUBLIC",
    "react-native",
    "cli",
    "lint"
  ],
  "homepage": "https://github.com/gligor99/expo-env-doctor#readme",
  "bugs": {
    "url": "https://github.com/gligor99/expo-env-doctor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gligor99/expo-env-doctor.git"
  },
  "license": "MIT",
  "author": "gligor99",
  "type": "module",
  "bin": {
    "expo-env-doctor": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@babel/parser": "^8.0.10",
    "@expo/env": "^2.5.3"
  },
  "devDependencies": {
    "@babel/types": "^8.0.10",
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "typescript": "~7.0",
    "vitest": "^5.0.5"
  }
}
